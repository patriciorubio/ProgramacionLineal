{
  "version": 2,
  "routes": [
    { "src": "/api/generate", "dest": "/api/generate.js" },
    { "src": "/(.*)",         "dest": "/public/$1"       }
  ],
  "functions": {
    "api/generate.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff"     },
        { "key": "X-Frame-Options",        "value": "DENY"        },
        { "key": "Referrer-Policy",        "value": "no-referrer" }
      ]
    }
  ]
}
